# The graalvm-pi-builder image used to capture the metadata: the single place its tag is pinned.
#
# Read by .github/workflows/build.yml and publish.yml (the KEY=value lines are appended to
# $GITHUB_ENV) and by
# scripts/generate-metadata.sh (the default when GRAALVM_PI_BUILDER_IMAGE is not already set),
# so keep this plain KEY=value: no spaces around `=`, no quotes, no `export`.
#
# Pinned to a version tag rather than a digest. graalvm-pi-builder is a first-party image we
# control; retagging this tag would be an intentional act. Digest pinning adds maintenance burden
# (every image rebuild produces a new digest) for negligible benefit here.
GRAALVM_PI_BUILDER_IMAGE=ghcr.io/lofthouse-dev/graalvm-pi-builder:bookworm-25.5.5.0.3
